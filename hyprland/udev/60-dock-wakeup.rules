# Installed to /etc/udev/rules.d/ by hyprland/install.sh.
#
# Docked (lid closed) the machine must wake from suspend on a key press on
# the USB keyboard plugged into the Dell WD22TB4 dock. The keyboard itself
# already has power/wakeup=enabled, but its wake request has to travel up
# through the dock's USB hubs and the Thunderbolt/PCIe bridges, and those
# default to wakeup=disabled -- so the key press never reached the CPU and
# only opening the lid woke the machine.
SUBSYSTEM=="usb", ATTR{bDeviceClass}=="09", ATTR{power/wakeup}="enabled"
SUBSYSTEM=="pci", ATTR{vendor}=="0x8086", ATTR{class}=="0x060400", ATTR{power/wakeup}="enabled"

# The Thunderbolt dock loses power in deep sleep (S3, forced by
# mem_sleep_default=deep on the kernel command line), so a key on its USB
# keyboard can't wake the machine. s2idle keeps it alive and works, but
# drains the battery much faster. So: s2idle while on AC, deep on battery.
# The "add" event at boot sets the initial state, "change" follows plug/unplug.
SUBSYSTEM=="power_supply", KERNEL=="AC", ATTR{online}=="1", RUN+="/bin/sh -c 'echo s2idle > /sys/power/mem_sleep'"
SUBSYSTEM=="power_supply", KERNEL=="AC", ATTR{online}=="0", RUN+="/bin/sh -c 'echo deep > /sys/power/mem_sleep'"
